<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 6.0-11 backup rules (API 23-30). Excludes all app data from
    Auto Backup to match the allowBackup="false" intent. Used alongside
    data_extraction_rules.xml which covers Android 12+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
